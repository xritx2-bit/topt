# Discord Bot Token (Get from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Discord Client / Application ID
CLIENT_ID=your_client_id_here

# Optional: Server / Guild ID (for instant guild-based slash command testing)
GUILD_ID=

# Bot prefix for text commands (e.g. topt cash, topt daily, t cf 50)
PREFIX=topt
ALT_PREFIX=t

# 24/7 Uptime Keep-Alive Settings
# On Render: RENDER_EXTERNAL_URL is automatically provided.
# If using a custom domain or testing locally:
KEEP_ALIVE_URL=https://your-service-name.onrender.com
KEEP_ALIVE_INTERVAL_MINUTES=10
